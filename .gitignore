node_modules/

# Secrets — never commit
.env

# Live data
data/*.db
data/*.db-wal
data/*.db-shm
uploads/*
backups/*

# Keep the empty directories themselves
!data/.gitkeep
!uploads/.gitkeep
!backups/.gitkeep

*.log

# Full-resolution source artwork. Kept on the owner's machine, never deployed:
# Render clones this repo on every deploy and has no use for 18MB of originals.
# What the site actually serves lives in public/img, generated from these once
# and committed. Never delete this folder locally -- it is the source of truth
# the derivatives come from.
images/originals/
