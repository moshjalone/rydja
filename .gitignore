node_modules/

# Secrets — never commit
.env

# Live data
data/*.db
data/*.db-wal
data/*.db-shm
uploads/*
backups/*

# Keep the empty directories themselves
!data/.gitkeep
!uploads/.gitkeep
!backups/.gitkeep

*.log

# Full-resolution source artwork. Kept on the owner's machine, never deployed:
# Render clones this repo on every deploy and has no use for 18MB of originals.
# What the site actually serves lives in public/img, generated from these once
# and committed. Never delete this folder locally -- it is the source of truth
# the derivatives come from.
images/originals/

# Local business-listing campaign working files. Operational notes, not site
# content and not for a public repo: they carry contact details, platform
# status and open questions about the business rather than anything the app
# needs. Kept on the owner's machine only.
business-listing-master.md
business-listing-tracker.csv
business-listing-research.md
