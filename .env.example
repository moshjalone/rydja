# Copy this file to .env and fill in the two secrets below.
# .env is gitignored — never commit it.

# ---- REQUIRED. The app refuses to start without these. ----

# Protects every /admin page. Minimum 12 characters, not a placeholder.
ADMIN_PASSWORD=

# Signs the admin session cookie. Minimum 32 characters.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ---- Optional ----

PORT=3000

# Shown in the header and footer. Change when naming is settled.
BRAND_NAME=WORKINGBRAND
BUSINESS_PHONE=

# The one operator in V1.
OWNER_NAME=Owner
OWNER_PHONE=
OWNER_EMAIL=

# Both must be on a persistent disk in production.
DB_PATH=./data/app.db
UPLOAD_DIR=./uploads
BACKUP_DIR=./backups

# Set to 1 only once the site is served over HTTPS. It marks the session
# cookie secure, which stops it being sent over plain HTTP.
SECURE_COOKIES=0
