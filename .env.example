# Copy this file to .env and fill in the two secrets below.
# .env is gitignored — never commit it.

# ---- REQUIRED. The app refuses to start without these. ----

# Protects every /admin page. Minimum 12 characters, not a placeholder.
ADMIN_PASSWORD=

# Signs the admin session cookie. Minimum 32 characters.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ---- Optional ----

PORT=3000

# Shown in the header and footer.
BRAND_NAME=RYDJA
BRAND_TAGLINE="Clear the way."
BUSINESS_PHONE=

# Public site URL, used for canonical and link-preview tags. No trailing slash.
SITE_URL=https://getrydja.com

# The one operator in V1.
OWNER_NAME=Owner
OWNER_PHONE=
OWNER_EMAIL=

# Both must be on a persistent disk in production.
DB_PATH=./data/app.db
UPLOAD_DIR=./uploads
BACKUP_DIR=./backups

# Secure cookies are ON automatically when NODE_ENV=production.
# Only uncomment this if your production host terminates TLS somewhere this
# app cannot detect and you are locked out of /admin as a result.
# SECURE_COOKIES=0

# Where you say you work. Drives the service-area section, the meta
# descriptions and the structured data, so all three stay in step.
SERVICE_AREA="Lowell, Stanton and surrounding West Michigan communities"
# The same places as discrete names, for schema.org areaServed. Pipe separated.
SERVICE_AREA_PLACES="Lowell, Michigan|Stanton, Michigan|West Michigan"

# Public contact address shown on the legal pages. Optional: the phone number
# alone is enough. Never put a home address anywhere public.
CONTACT_EMAIL=

# Your Google Business Profile review link. When set, a customer whose job is
# complete is offered it on their own page -- the same link for everyone, no
# incentive, no filtering, no automatic redirect. Leave blank to show nothing.
GOOGLE_REVIEW_URL=

# ---- Customer email (Resend) ----
# When an admin sends or revises a quote, the customer gets it by email with a
# link to their private page. Leave these blank and nothing is sent — quotes
# still save, and the admin texts the link as before.
#
# Get a key at resend.com and verify the sending domain first.
RESEND_API_KEY=
# Must be on a domain verified in Resend. e.g. "RYDJA <quotes@getrydja.com>"
EMAIL_FROM=

# ---- Daily backup ----
# The app runs a backup every day at BACKUP_HOUR local time.
BACKUP_DAILY=1
BACKUP_HOUR=3
BACKUP_KEEP_LOCAL=7

# Off-site copy. Without these the backup sits on the same disk as the
# original, which does not protect you. Works with Cloudflare R2, Backblaze
# B2, Wasabi, DigitalOcean Spaces and S3. See DEPLOY.md.
# BACKUP_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# BACKUP_S3_BUCKET=property-services-backups
# BACKUP_S3_ACCESS_KEY_ID=
# BACKUP_S3_SECRET_ACCESS_KEY=
# BACKUP_S3_REGION=auto
# BACKUP_S3_PREFIX=

# ---- Production only ----
# NODE_ENV=production      # enables secure cookies and proxy trust
# TZ=America/Detroit       # so scheduled job times read correctly
