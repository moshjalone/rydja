<%- include('partials/head', {
  fullTitle: 'Junk Removal & Cleanout Services Near Lowell, MI | RYDJA',
  canonicalPath: '/services',
  description: '23 services: junk removal, estate and garage cleanouts, rental turnovers, yard waste, brush, shed removal and moving help in ' + anchorArea + '. Free quotes.'
}) %>

<main id="main" tabindex="-1" class="section shell">
  <nav class="crumbs" aria-label="Breadcrumb">
    <a href="/">Home</a> <span aria-hidden="true">&rsaquo;</span>
    <span aria-current="page">Services</span>
  </nav>

  <div class="section-heading">
    <div class="eyebrow">SERVICES</div>
    <h1>Junk removal, cleanouts and property services</h1>
    <p class="lede smaller">
      Every job below has a page of its own explaining how it runs, what it covers and what we cannot take.
      All of it is quoted the same way: send photographs, get a price, decide. Serving <%= serviceArea %>.
    </p>
  </div>

  <%# One card per real page, from the canonical catalog. There is no second
      list of services anywhere -- a card here cannot exist without the page
      it links to, which is the whole point of building it this way. %>
  <div class="service-grid">
    <% servicePages.forEach(function(p, i) { %>
      <article<%= i === 0 ? ' class="flagship-card"' : '' %>>
        <% if (i === 0) { %><div class="eyebrow">FLAGSHIP</div><% } %>
        <h3><a href="/<%= p.slug %>"><%= p.card.title %></a></h3>
        <p><%= p.card.blurb %></p>
        <div class="card-links">
          <a class="text-link" href="/<%= p.slug %>">Read about <%= p.card.title.toLowerCase() %> &rarr;</a>
          <a class="text-link" href="/quote?service=<%= encodeURIComponent(p.quoteService) %>">Get a quote &rarr;</a>
        </div>
      </article>
    <% }) %>
  </div>

  <%# The B2B page, in a band of its own rather than as an eighth homeowner
      card. It is not a service somebody buys -- it is the page we hand to
      people who place this work on somebody else's behalf. %>
  <section class="flagship pro-band" aria-labelledby="pro-band-head">
    <div class="flagship-copy">
      <div class="eyebrow">FOR PROPERTY PROFESSIONALS</div>
      <h2 id="pro-band-head">Placing cleanout work for somebody else?</h2>
      <p class="lede smaller">
        Realtors, property managers, landlords, estate-sale companies, auctioneers, senior move managers and
        investors use RYDJA as the crew that clears a property. Photo-based scoping, one point of contact, and a
        quote you approve before anything is scheduled.
      </p>
      <div class="hero-actions">
        <a class="button" href="/property-professionals">How RYDJA works with professionals</a>
        <a class="text-link" href="/quote?service=<%= encodeURIComponent('Rental / property turnover') %>">Request a property cleanout quote &rarr;</a>
      </div>
    </div>
    <ul class="flagship-list">
      <li>Estate and inherited-property cleanouts</li>
      <li>Rental turnovers between tenants</li>
      <li>Pre-listing property clearing</li>
      <li>Garages, basements and outbuildings</li>
      <li>Furniture, appliance and debris removal</li>
      <li>Light demolition where it is appropriate</li>
    </ul>
  </section>

  <%# ---- the full catalog, in the customer's own words ----

      Twenty-three offerings, the same ones listed on the Google Business
      Profile, each one a link to the page that describes it and a link to a
      quote form with the right service already selected.

      This replaced a flat list of keyword phrases. The phrases were honest but
      they went nowhere: somebody who had just read the words "attic cleanout"
      still had to work out which of eight pages covered it. Now the words they
      typed are the link.

      Twenty-three separate pages would be the other way to do this, and it
      would be doorway pages with extra steps -- the same business, crew and
      truck described twenty-three times. %>
  <section class="catalog" aria-labelledby="catalog-head">
    <h2 class="sub-head" id="catalog-head">Everything we take on</h2>
    <p class="price-note">
      Find your job, read how it runs, or go straight to a free quote with it already filled in.
    </p>

    <% catalogGroups.forEach(function(group) { %>
      <div class="panel catalog-group">
        <h3>
          <%= group.label %>
          <a class="text-link catalog-page-link" href="/<%= group.page %>">how this works &rarr;</a>
        </h3>
        <p class="catalog-blurb"><%= group.blurb %></p>
        <ul class="catalog-list">
          <% catalogByGroup(group.key).forEach(function(s) { %>
            <li>
              <div class="catalog-name">
                <a class="text-link" href="/<%= s.page %>"><%= s.name %></a>
              </div>
              <p class="catalog-says"><%= s.says %></p>
              <%# The limit, where there is one. On the page rather than in a
                  footnote: somebody whose job is actually a tree felling needs
                  to know that here, not after a phone call. %>
              <% if (s.limit) { %><p class="catalog-limit"><%= s.limit %></p><% } %>
              <a class="text-link catalog-quote" href="/quote?service=<%= encodeURIComponent(s.quote) %>">
                Free quote for <%= s.name.toLowerCase() %> &rarr;
              </a>
            </li>
          <% }) %>
        </ul>
      </div>
    <% }) %>

    <p class="price-note">
      Not sure where yours fits? Send a photograph and ask &mdash; if it is property work, it is probably on the
      list, and we will tell you plainly if it is not.
    </p>
  </section>

  <div class="panel notice">
    <h3>What we can&rsquo;t take</h3>
    <p>No hazardous waste, asbestos, biohazards, unknown chemicals, regulated medical waste or similar. If you are unsure about something, send a photo and ask before the crew arrives.</p>
  </div>

  <p class="center-cta">
    <a class="button" href="/quote">Get a Free Quote</a>
  </p>
  <p class="center-cta">
    <a class="text-link" href="/service-area">See where RYDJA works &rarr;</a>
  </p>
</main>

<script type="application/ld+json"><%- breadcrumbJsonLd %></script>

<%- include('partials/foot') %>
