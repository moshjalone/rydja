<%- include('partials/head', { title: 'Your Job', noindex: true }) %>

<main id="main" tabindex="-1" class="section shell narrow">
  <%# The permanent work reference. Public on purpose, and not a capability --
      only the token in the URL grants access. It reads "Request" before the
      work exists and "Job" after, but the reference itself never changes. %>
  <div class="eyebrow"><%= job ? 'JOB' : 'REQUEST' %> <%= lead.work_ref %></div>

  <% if (!quote) { %>
    <h2>We&rsquo;ve got it.</h2>
    <p class="lede smaller">Your request is in front of us now. We&rsquo;ll review the photos and send a price here&mdash;usually same day.</p>
  <% } else if (quote.status === 'sent') { %>
    <h2>Your quote is ready.</h2>
  <% } else if (quote.status === 'declined') { %>
    <h2>Quote declined.</h2>
    <p class="lede smaller">No problem. If something changes<% if (businessPhone) { %>, call or text <a class="text-link" href="tel:<%= telHref(businessPhone) %>"><%= businessPhone %></a><% } %>.</p>
  <% } else if (job && job.status === 'complete') { %>
    <h2>Job complete.</h2>
    <p class="lede smaller">Finished <%= prettyDate(job.completed_at) %>. Thanks for the work.</p>
  <% } else if (job && job.scheduled_for && job.status === 'scheduled') { %>
    <h2>You&rsquo;re booked.</h2>
    <p class="lede smaller">Confirmed for <strong><%= prettyWhen(job.scheduled_for) %></strong>. See you then.</p>
  <% } else { %>
    <h2>You&rsquo;re booked.</h2>
    <p class="lede smaller">
      <% if (job && job.proposed_for) { %>We&rsquo;ve proposed a time below &mdash; confirm it and you&rsquo;re set.
      <% } else { %>We&rsquo;ll reach out to lock in a time window.<% } %>
    </p>
  <% } %>

  <%# ---- the appointment, if one has been offered ---- %>
  <% if (job && job.proposed_for && !(job.status === 'scheduled' && job.scheduled_for === job.proposed_for)) { %>
    <div class="panel" id="appointment">
      <h3>Proposed appointment</h3>
      <div class="big-when"><%= prettyWhen(job.proposed_for) %></div>

      <% if (job.schedule_message) { %>
        <p class="price-note">
          You asked for a different time on <%= prettyDate(job.schedule_responded_at) %>. We&rsquo;ll be in touch with
          another option &mdash; or you can still take the time above if it turns out to work.
        </p>
      <% } else { %>
        <p class="price-note">Nothing is locked in until you confirm.</p>
      <% } %>

      <form method="post" action="/q/<%= lead.public_token %>/schedule" class="approve-row">
        <button class="button full" type="submit" name="decision" value="accept">Accept this time</button>
      </form>

      <%# A <details> rather than a script: the textarea is one tap away and the
          page still works with nothing enabled. %>
      <details class="ask-different"<%= job.schedule_message ? ' open' : '' %>>
        <summary>Ask for a different time</summary>
        <form method="post" action="/q/<%= lead.public_token %>/schedule" class="stack-form">
          <label>What works better for you?
            <textarea name="message" rows="3" required placeholder="Example: Mornings are hard &mdash; any afternoon that week works."><%= job.schedule_message || '' %></textarea>
          </label>
          <button class="button ghost full" type="submit" name="decision" value="change">Send this to us</button>
        </form>
      </details>
    </div>
  <% } else if (job && job.status === 'scheduled' && job.scheduled_for) { %>
    <div class="panel" id="appointment">
      <h3>Your appointment</h3>
      <div class="big-when"><%= prettyWhen(job.scheduled_for) %></div>
      <p class="price-note">Confirmed <%= prettyDate(job.schedule_responded_at) %>.</p>
    </div>
  <% } %>

  <p class="bookmark-hint">Bookmark this page &mdash; it&rsquo;s your private link to this job.</p>

  <% if (quote) { %>
    <div class="panel quote-panel">
      <div class="panel-head">
        <h3>Quote</h3>
        <span class="badge <%= quote.status %>"><%= prettyStatus(quote.status) %></span>
      </div>
      <div class="big-price"><%= money(quote.amount_cents) %></div>
      <p class="price-note">Labor, hauling and disposal included unless noted below.</p>
      <% if (quote.notes) { %><div class="quote-notes"><%= quote.notes %></div><% } %>

      <% if (quote.status === 'sent') { %>
        <% if (quote.proposed_for) { %>
          <%# Price and time in one decision. The time is still only an offer:
              it reaches scheduled_for only by way of this button. %>
          <%# The disclosure sits directly above the approve buttons, not behind a
              link or a checkbox. Approval stays one click. %>
          <p class="approve-terms">
            By approving, you confirm that you have authority to authorize this work and agree to RYDJA&rsquo;s
            <a class="text-link" href="/terms" target="_blank" rel="noopener">Terms of Service</a>, including the
            removal and lawful disposal, recycling, donation, scrapping, reuse or resale of items you designate for
            removal. Anything you want kept must be pointed out before the crew loads it.
          </p>

          <div class="proposed-inline">
            <div class="mini-label">PROPOSED APPOINTMENT</div>
            <div class="big-when"><%= prettyWhen(quote.proposed_for) %></div>
          </div>

          <form method="post" action="/q/<%= lead.public_token %>/respond" class="approve-row">
            <button class="button full" type="submit" name="decision" value="approve_confirm">Approve quote &amp; confirm time</button>
          </form>

          <details class="ask-different">
            <summary>Approve, but I need a different time</summary>
            <form method="post" action="/q/<%= lead.public_token %>/respond" class="stack-form">
              <label>What works better for you?
                <textarea name="message" rows="3" required placeholder="Example: Mornings are hard &mdash; any afternoon that week works."></textarea>
              </label>
              <button class="button ghost full" type="submit" name="decision" value="approve_change">Approve quote, send this time instead</button>
            </form>
          </details>

          <form method="post" action="/q/<%= lead.public_token %>/respond" class="approve-row secondary-row">
            <button class="linkish danger" type="submit" name="decision" value="decline">Decline quote</button>
          </form>
        <% } else { %>
          <%# The disclosure sits directly above the approve buttons, not behind a
              link or a checkbox. Approval stays one click. %>
          <p class="approve-terms">
            By approving, you confirm that you have authority to authorize this work and agree to RYDJA&rsquo;s
            <a class="text-link" href="/terms" target="_blank" rel="noopener">Terms of Service</a>, including the
            removal and lawful disposal, recycling, donation, scrapping, reuse or resale of items you designate for
            removal. Anything you want kept must be pointed out before the crew loads it.
          </p>

          <form method="post" action="/q/<%= lead.public_token %>/respond" class="approve-row">
            <button class="button full" type="submit" name="decision" value="approve">Approve this quote</button>
            <button class="linkish danger" type="submit" name="decision" value="decline">Decline</button>
          </form>
        <% } %>
      <% } %>
    </div>
  <% } %>

  <div class="panel">
    <h3>What you sent</h3>
    <dl class="kv">
      <div><dt>Service</dt><dd><%= lead.service %></dd></div>
      <div><dt>Location</dt><dd><%= [lead.address, lead.city, lead.state, lead.zip].filter(Boolean).join(', ') %></dd></div>
      <% if (lead.access) { %><div><dt>Access</dt><dd><%= lead.access %></dd></div><% } %>
      <% if (lead.timing) { %><div><dt>Timing</dt><dd><%= lead.timing %></dd></div><% } %>
      <div><dt>Submitted</dt><dd><%= prettyDate(lead.created_at) %></dd></div>
    </dl>
    <p class="desc-block"><%= lead.description %></p>
  </div>

  <%# ---- a question, at any point ---- %>
  <% if (!quote || quote.status !== 'declined') { %>
    <div class="panel" id="ask">
      <h3>Ask a question</h3>
      <% if (asked) { %>
        <p class="price-note">Got it &mdash; we&rsquo;ll come back to you<% if (businessPhone) { %>, or call us on <a class="text-link" href="tel:<%= telHref(businessPhone) %>"><%= businessPhone %></a><% } %>.</p>
      <% } %>
      <form method="post" action="/q/<%= lead.public_token %>/ask" class="stack-form">
        <label>What would you like to know?
          <textarea name="question" rows="3" required maxlength="1000" placeholder="Example: Does the price cover the shed out back?"><%= lead.customer_message || '' %></textarea>
        </label>
        <button class="button ghost full" type="submit">Send</button>
      </form>
      <% if (businessPhone) { %>
        <small class="fineprint">Faster: call or text <a class="text-link" href="tel:<%= telHref(businessPhone) %>"><%= businessPhone %></a>.</small>
      <% } %>
    </div>
  <% } %>

  <% if (photos.length) { %>
    <% ['before', 'after'].forEach(function(phase) {
         var set = photos.filter(function(p) { return p.phase === phase; });
         if (!set.length) return; %>
      <div class="panel">
        <h3><%= phase === 'before' ? 'Before' : 'After' %></h3>
        <div class="photo-grid">
          <% set.forEach(function(p) { %>
            <a href="/uploads/<%= p.filename %>" target="_blank" rel="noopener"><img src="/uploads/<%= p.filename %>" alt="<%= phase %> photo" loading="lazy"></a>
          <% }) %>
        </div>
      </div>
    <% }) %>
  <% } %>
</main>

<%- include('partials/foot') %>
