<%- include('partials/head', {
  fullTitle: page.title,
  canonicalPath: '/' + page.slug,
  description: page.description
}) %>

<%# What a CTA on this page prefills the quote form with. Defaults to the
    nav label, which is the right answer for every page whose nav label is one
    of the form's options. %>
<% var quoteFor = page.quoteService || page.nav %>

<main id="main" tabindex="-1" class="section shell narrow legal service-page">
  <nav class="crumbs" aria-label="Breadcrumb">
    <a href="/">Home</a> <span aria-hidden="true">&rsaquo;</span>
    <a href="/services">Services</a> <span aria-hidden="true">&rsaquo;</span>
    <span aria-current="page"><%= page.nav %></span>
  </nav>

  <h1><%= page.h1 %></h1>
  <p class="lede smaller"><%- page.lede %></p>

  <% page.intro.forEach(function(para) { %><p><%- para %></p><% }) %>

  <p class="cta-inline">
    <a class="button" href="/quote?service=<%= encodeURIComponent(quoteFor) %>">Send photos for a quote</a>
    <% if (businessPhone) { %>
      <span class="or-call">or call or text <a class="text-link" href="tel:<%= telHref(businessPhone) %>"><%= businessPhone %></a></span>
    <% } %>
  </p>

  <%# Rhythm: intro and CTA, then one strong photograph, then the detail.
      A page only gets one if page data names one -- there is no placeholder
      and no decorative filler. %>
  <% if (page.images && page.images.afterIntro) { %>
    <%- include('partials/service-image', { img: page.images.afterIntro }) %>
  <% } %>

  <h2><%= page.jobsHeading %></h2>
  <ul>
    <% page.jobs.forEach(function(job) { %><li><%- job %></li><% }) %>
  </ul>

  <%# How a job runs. A page may write its own version of this -- the flagship
      does, because a whole property is several visits and several loads and
      the shared paragraph is too short to be useful there. Either the page's
      own steps or the shared explanation, never both: they cover the same
      ground, and printing them one after the other reads as padding. %>
  <% if (page.steps) { %>
    <h2><%= page.stepsHeading %></h2>
    <ol class="area-steps">
      <% page.steps.forEach(function(step) { %>
        <li><strong><%= step.h %></strong> &mdash; <%- step.p %></li>
      <% }) %>
    </ol>
    <p>
      Nothing is booked and nothing is owed until you approve the quote. Send the job through the
      <a class="text-link" href="/quote">quote form</a> whenever you are ready.
    </p>
  <% } else { %>
    <h2>How the quote works</h2>
    <p>
      Send photos of the job through the <a class="text-link" href="/quote">quote form</a> along with a short
      description and where the property is. We look at volume, access, labour and disposal, then send you a price.
      Nothing is booked and nothing is owed until you approve it &mdash; and if you approve a time we have proposed,
      the job is scheduled the moment you confirm it.
    </p>
  <% } %>

  <%# A second supporting visual, only where the page is long enough to earn
      one. Short pages stop at the first. %>
  <% if (page.images && page.images.afterSteps) { %>
    <%- include('partials/service-image', { img: page.images.afterSteps }) %>
  <% } %>

  <h2>What to expect</h2>
  <% page.expect.forEach(function(item) { %>
    <h3><%= item.h %></h3>
    <p><%- item.p %></p>
  <% }) %>

  <%# Optional prose sections, for what a page needs to say at length and
      would be a lie as a bullet. Each carries paragraphs, an optional list
      and an optional closing note. %>
  <% (page.sections || []).forEach(function(block) { %>
    <h2><%= block.h %></h2>
    <% (block.paras || []).forEach(function(para) { %><p><%- para %></p><% }) %>
    <% if (block.list) { %>
      <ul>
        <% block.list.forEach(function(item) { %><li><%- item %></li><% }) %>
      </ul>
    <% } %>
    <% if (block.note) { %><p><%- block.note %></p><% } %>
  <% }) %>

  <div class="panel notice">
    <h3>What we can&rsquo;t take on</h3>
    <ul>
      <% page.limits.forEach(function(limit) { %><li><%- limit %></li><% }) %>
    </ul>
    <p>If you are not sure about something, send a photo and ask before the crew is booked.</p>
  </div>

  <h2>Common questions</h2>
  <% page.faqs.forEach(function(faq) { %>
    <h3><%= faq.q %></h3>
    <p><%- faq.a %></p>
  <% }) %>

  <h2>Where we work</h2>
  <p>
    We serve <%= serviceArea %>. If you are just outside that, it is still worth asking &mdash; see the
    <a class="text-link" href="/service-area">service area</a> for how we decide.
  </p>

  <h2>Related work</h2>
  <p>You might also want:</p>
  <ul>
    <% page.related.forEach(function(rel) { %>
      <li><a class="text-link" href="<%= rel.href %>"><%- rel.label %></a></li>
    <% }) %>
  </ul>

  <p class="cta-inline">
    <a class="button" href="/quote?service=<%= encodeURIComponent(quoteFor) %>">Request a quote</a>
  </p>
</main>

<script type="application/ld+json"><%- jsonLd %></script>
<script type="application/ld+json"><%- breadcrumbJsonLd %></script>

<%- include('partials/foot') %>
