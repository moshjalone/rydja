<%
  // These come from the include() call in each page. An EJS include has its own
  // scope, so a `var` in the parent template would not be visible here — each
  // page must pass what it wants to override.
  // fullTitle wins outright, for a page whose title is not "<thing> — RYDJA".
  var pageTitle = locals.fullTitle
    ? locals.fullTitle
    : locals.title
      ? locals.title + ' — ' + brand
      : brand + ' — ' + tagline;
  var pageDescription = locals.description ||
    'Cleanouts, hauling, yard cleanup, furniture removal and moving help. Send photos, get a price, get it handled.';
  // Private means the customer's own page and the whole admin. These get a hard
  // noindex and no canonical, no Open Graph, nothing a crawler could index or a
  // chat app could unfurl.
  var isPrivate = locals.noindex === true;
  var pageUrl = siteUrl + (locals.canonicalPath || '/');
%><!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title><%= pageTitle %></title>
  <meta name="description" content="<%= pageDescription %>">
  <% if (isPrivate) { %>
    <meta name="robots" content="noindex,nofollow">
  <% } else { %>
    <link rel="canonical" href="<%= pageUrl %>">
    <%# Search Console ownership, when a token is configured. Only on the
        indexable pages: proving you own the host does not require putting a
        token on a customer's private job page, and the admin is noindex. %>
    <% if (googleSiteVerification) { %><meta name="google-site-verification" content="<%= googleSiteVerification %>"><% } %>
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="<%= brand %>">
    <meta property="og:title" content="<%= pageTitle %>">
    <meta property="og:description" content="<%= pageDescription %>">
    <meta property="og:url" content="<%= pageUrl %>">
    <meta property="og:locale" content="en_US">
    <meta property="og:image" content="<%= siteUrl %>/og-image.jpg?v=<%= assetV.og %>">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="<%= brand %> — <%= tagline %>">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= pageTitle %>">
    <meta name="twitter:description" content="<%= pageDescription %>">
    <meta name="twitter:image" content="<%= siteUrl %>/og-image.jpg?v=<%= assetV.og %>">
  <% } %>

  <%# The icon set shares one version: the files change together. %>
  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png?v=<%= assetV.icons %>">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png?v=<%= assetV.icons %>">
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=<%= assetV.icons %>">
  <link rel="manifest" href="/site.webmanifest?v=<%= assetV.icons %>">
  <meta name="theme-color" content="#171816">

  <link rel="stylesheet" href="/styles.css?v=<%= assetV.css %>">
  <%# The stylesheet cannot carry a version into its own url(), so the hero art
      is passed in as a custom property and versioned here instead. %>
  <style>:root{--hero-art:url("/hero.svg?v=<%= assetV.hero %>");--rig-art:url("/rig.svg?v=<%= assetV.rig %>")}</style>
  <script src="/app.js?v=<%= assetV.js %>" defer></script>
</head>
<%# The class reserves room at the bottom of the page for the fixed mobile
    call/quote bar, on exactly the pages that render one. %>
<body<%- locals.mobileCta ? ' class="has-mobile-cta"' : '' %>>
<a class="skip-link" href="#main">Skip to content</a>
<header class="nav">
  <a class="brand" href="/"><%= brand %></a>
  <nav>
    <a href="/services">Services</a>
    <a href="/#how">How it works</a>
    <% if (isAdmin) { %><a href="/admin/dashboard">Dashboard</a><a href="/admin/leads">Leads</a><a href="/admin/jobs">Jobs</a><% } %>
  </nav>
  <a class="button small" href="/quote">Get a Quote</a>
</header>

<%# Admin navigation for a phone.

    The header's <nav> is display:none below 860px -- that is deliberate for
    the public links, which have a footer and a homepage to live in. For an
    admin it was a dead end: Dashboard, Leads and Jobs lived only in that
    hidden nav, so on a phone the only way between admin sections was editing
    the address bar.

    So this is a second, separate nav that exists only where the first one is
    hidden. Plain links, server-rendered, no script: if JavaScript is off this
    behaves identically, which matters for the one person who has to run the
    business from a truck.

    Shown only when BOTH conditions hold -- signed in AND already inside the
    admin. The second half is why a customer's own /q/<token> page and every
    public page stay clean even while Josh is signed in: an operator bar has
    no business sitting over a page a customer is reading. The footer already
    carries an Admin link for getting back in from the public site.

    Not sticky, on purpose. The header above it already is, and the lead and
    job lists have a sticky bulk-action bar at the bottom; a third fixed strip
    would be competing for the same small screen and would have to know the
    header's exact height to sit under it. %>
<% if (isAdmin && adminArea) { %>
  <%
    // Section, not page: /admin/leads/7/edit is still Leads.
    const adminSections = [
      { href: '/admin/dashboard', label: 'Dashboard' },
      { href: '/admin/leads', label: 'Leads' },
      { href: '/admin/jobs', label: 'Jobs' }
    ];
  %>
  <nav class="admin-nav" aria-label="Admin sections">
    <% adminSections.forEach(function(section) { %>
      <% const here = currentPath === section.href || currentPath.startsWith(section.href + '/'); %>
      <a href="<%= section.href %>"<%- here ? ' class="here" aria-current="page"' : '' %>><%= section.label %></a>
    <% }) %>
  </nav>
<% } %>
