<footer class="shell footer">
  <div>
    <div class="brand"><%= brand %></div>
    <p><%= tagline %> Junk removal, cleanouts and property help.</p>
    <p>Serving <%= serviceArea %>.</p>
    <p>
      <% if (businessPhone) { %>Call or text <a class="text-link" href="tel:<%= telHref(businessPhone) %>"><%= businessPhone %></a> &middot; <% } %><a class="text-link" href="<%= siteUrl %>/">getrydja.com</a>
    </p>
  </div>
  <div class="footer-legal">
    <nav class="footer-links" aria-label="Legal and contact">
      <a href="/services">Services</a>
      <a href="/service-area">Service Area</a>
      <a href="/quote">Get a Quote</a>
      <a href="/privacy">Privacy</a>
      <a href="/terms">Terms</a>
      <a href="/accessibility">Accessibility</a>
      <%# The quote form is the real intake path, so Contact goes there. The
          phone stays its own tel: link in the block above. %>
      <a href="/quote">Contact</a>
    </nav>
    <p class="copyright">&copy; <%= year %> <%= brand %>. All rights reserved.</p>
    <p>
      <% if (isAdmin) { %>
        <a href="/admin/leads">Admin</a> ·
        <form method="post" action="/admin/logout" class="inline-form"><button class="linkish" type="submit">Sign out</button></form>
      <% } else { %>
        <a href="/admin/login">Staff sign in</a>
      <% } %>
    </p>
  </div>
</footer>
</body>
</html>
