<%- include('partials/head', {
  fullTitle: 'RYDJA | Junk Removal, Cleanouts & Property Help in West Michigan',
  canonicalPath: '/',
  description: 'Fast local junk removal, cleanouts, yard cleanup and furniture removal in ' + serviceArea + '. Send photos for a quote.'
}) %>

<main id="main" tabindex="-1">
  <%# The hero art is full-bleed, so the band wraps the shell rather than
      living on it. Homepage only -- no other page carries it. %>
  <div class="hero-band">
  <section class="hero shell">
    <div class="hero-copy">
      <div class="eyebrow">LOCAL PROPERTY HELP • FAST QUOTES</div>
      <p class="hero-slogan">Point at the problem.<br><span>We&rsquo;ll handle the rest.</span></p>
      <h1 class="hero-h1">Junk Removal &amp; Cleanouts in West Michigan</h1>
      <p class="lede">
        RYDJA is a local junk removal and hauling business. We handle cleanouts, yard cleanup, furniture and
        appliance removal, moving help, debris hauling and property cleanup &mdash; and the jobs you just need
        finished. Send photos, get a price, get it handled.
      </p>
      <div class="hero-actions">
        <a class="button" href="/quote">Send Photos for a Quote</a>
        <a class="text-link" href="/services">See what we do &rarr;</a>
      </div>
      <div class="trust-row">
        <div><strong>Fast</strong><span>photo quotes</span></div>
        <div><strong>Local</strong><span>real operators</span></div>
        <div><strong>Smart</strong><span>reuse before landfill</span></div>
      </div>
    </div>
    <aside class="quote-card">
      <div class="mini-label">THE EASY WAY TO START</div>
      <h2>What needs done?</h2>
      <p>Upload a few photos and tell us where the job is. We review it and send a price.</p>
      <a class="button full" href="/quote">Request Quote</a>
      <small>No obligation. We review the job before pricing.</small>
    </aside>
  </section>
  </div>

  <%# Estate and whole-property cleanouts: the highest-value work the
      business takes on, so it gets named before the grid rather than being
      one card in it. Deliberately restrained -- no second hero. %>
  <section id="estate" class="section shell flagship">
    <div class="flagship-copy">
      <div class="eyebrow">FLAGSHIP SERVICE</div>
      <h2>Estate &amp; whole-property cleanouts</h2>
      <p class="lede smaller">
        One room or an entire property. We can clear the house, garage, basement, barn and outbuildings and help
        you get the property ready for what comes next &mdash; at the pace the family needs.
      </p>
      <div class="hero-actions">
        <a class="button" href="/quote?service=<%= encodeURIComponent(estateService) %>">Get an Estate Cleanout Quote</a>
        <a class="text-link" href="/estate-cleanouts">How an estate cleanout works &rarr;</a>
      </div>
    </div>
    <ul class="flagship-list">
      <li>Estate and inherited-home cleanouts</li>
      <li>Whole-house cleanouts and downsizing</li>
      <li>Moving and relocation clear-outs</li>
      <li>Garage, basement, attic and barn</li>
      <li>Getting a property ready to sell</li>
      <li>Landlord and property-manager clearing</li>
    </ul>
  </section>

  <section id="services" class="section shell">
    <div class="section-heading">
      <div class="eyebrow">SERVICES</div>
      <h2>One place for the jobs around your property.</h2>
    </div>
    <div class="service-grid">
      <% servicePages.forEach(function(p) { %>
        <article>
          <h3><a href="/<%= p.slug %>"><%= p.nav %></a></h3>
          <p><%= p.description %></p>
          <a class="text-link" href="/<%= p.slug %>"><%= p.h1 %> &rarr;</a>
        </article>
      <% }) %>
    </div>
    <p class="center-cta">
      <a class="text-link" href="/service-area">See the full service area across West Michigan &rarr;</a>
    </p>
  </section>

  <section id="how" class="section contrast">
    <div class="shell">
      <div class="section-heading">
        <div class="eyebrow">HOW IT WORKS</div>
        <h2>Skip the phone-tag.</h2>
      </div>
      <div class="steps">
        <div><span>01</span><h3>Show us</h3><p>Choose a service and upload photos.</p></div>
        <div><span>02</span><h3>Get priced</h3><p>We review access, volume, labor and disposal needs.</p></div>
        <div><span>03</span><h3>Approve</h3><p>Approve the quote from your phone and pick a time.</p></div>
        <div><span>04</span><h3>Done</h3><p>We complete the job and send before/after photos.</p></div>
      </div>
    </div>
  </section>

  <%# Owner. One photograph, used once, with his permission and his agreement
      to be named. No biography, no address, no family. %>
  <section id="owner" class="section shell owner-strip">
    <figure class="owner-photo">
      <picture>
        <source srcset="/img/josh-owner-rydja.webp?v=<%= assetV.owner %>" type="image/webp">
        <img src="/img/josh-owner-rydja.jpg?v=<%= assetV.owner %>"
             width="800" height="600" loading="lazy" decoding="async"
             alt="Josh, owner of RYDJA, beside a RYDJA work truck">
      </picture>
    </figure>
    <div class="owner-copy">
      <div class="eyebrow">LOCALLY OWNED</div>
      <h2>Locally owned. Personally handled.</h2>
      <p class="lede smaller">
        RYDJA is owner-operated. The person who reads your photos and prices your job is the person who turns up to
        do it.
      </p>
      <p class="owner-name"><strong>Josh</strong> &mdash; Owner/Operator</p>
      <% if (businessPhone) { %>
        <p class="price-note">
          Call or text <a class="text-link" href="tel:<%= telHref(businessPhone) %>"><%= businessPhone %></a>, or
          <a class="text-link" href="/quote">send photos for a quote</a>.
        </p>
      <% } %>
      <%# Where the work actually gets posted. Same two profiles as the footer,
          same configuration: a profile with no URL set is simply not named
          here, and the sentence still reads as a sentence without it. %>
      <%
        const ownerSocials = [
          facebookUrl && { url: facebookUrl, label: 'RYDJA on Facebook', network: 'facebook' },
          instagramUrl && { url: instagramUrl, label: 'RYDJA on Instagram', network: 'instagram' }
        ].filter(Boolean);
      %>
      <% if (ownerSocials.length) { %>
        <p class="price-note">
          See recent work and updates on
          <% ownerSocials.forEach((s, i) => { %>
            <% if (i > 0) { %>and<% } %>
            <a class="text-link social-inline" href="<%= s.url %>" target="_blank" rel="noopener noreferrer me"><% if (s.network === 'facebook') { %><svg class="social-icon" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M22 12.06C22 6.5 17.52 2 12 2S2 6.5 2 12.06c0 5 3.66 9.15 8.44 9.94v-7.03H7.9v-2.91h2.54V9.85c0-2.52 1.49-3.91 3.77-3.91 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.78-1.63 1.57v1.89h2.78l-.45 2.91h-2.33V22c4.78-.79 8.44-4.93 8.44-9.94z"/></svg><% } else { %><svg class="social-icon" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2c2.72 0 3.06.01 4.12.06 1.07.05 1.79.22 2.43.47.66.25 1.22.6 1.77 1.15.55.55.9 1.11 1.15 1.77.25.64.42 1.36.47 2.43.05 1.06.06 1.4.06 4.12s-.01 3.06-.06 4.12c-.05 1.07-.22 1.79-.47 2.43-.25.66-.6 1.22-1.15 1.77-.55.55-1.11.9-1.77 1.15-.64.25-1.36.42-2.43.47-1.06.05-1.4.06-4.12.06s-3.06-.01-4.12-.06c-1.07-.05-1.79-.22-2.43-.47a4.9 4.9 0 0 1-1.77-1.15 4.9 4.9 0 0 1-1.15-1.77c-.25-.64-.42-1.36-.47-2.43C2.01 15.06 2 14.72 2 12s.01-3.06.06-4.12c.05-1.07.22-1.79.47-2.43.25-.66.6-1.22 1.15-1.77A4.9 4.9 0 0 1 5.45 2.53c.64-.25 1.36-.42 2.43-.47C8.94 2.01 9.28 2 12 2zm0 1.8c-2.67 0-2.99.01-4.04.06-.82.04-1.27.17-1.56.29-.4.15-.68.34-.98.64-.3.3-.49.58-.64.98-.12.29-.25.74-.29 1.56-.05 1.05-.06 1.37-.06 4.04s.01 2.99.06 4.04c.04.82.17 1.27.29 1.56.15.4.34.68.64.98.3.3.58.49.98.64.29.12.74.25 1.56.29 1.05.05 1.37.06 4.04.06s2.99-.01 4.04-.06c.82-.04 1.27-.17 1.56-.29.4-.15.68-.34.98-.64.3-.3.49-.58.64-.98.12-.29.25-.74.29-1.56.05-1.05.06-1.37.06-4.04s-.01-2.99-.06-4.04c-.04-.82-.17-1.27-.29-1.56a2.64 2.64 0 0 0-.64-.98 2.64 2.64 0 0 0-.98-.64c-.29-.12-.74-.25-1.56-.29-1.05-.05-1.37-.06-4.04-.06zm0 3.07a5.13 5.13 0 1 1 0 10.26 5.13 5.13 0 0 1 0-10.26zm0 1.8a3.33 3.33 0 1 0 0 6.66 3.33 3.33 0 0 0 0-6.66zm6.54-2a1.2 1.2 0 1 1-2.4 0 1.2 1.2 0 0 1 2.4 0z"/></svg><% } %><span><%= s.label %></span></a><% if (i === ownerSocials.length - 1) { %>.<% } %>
          <% }) %>
        </p>
      <% } %>
    </div>
  </section>

  <%# Service area. Named plainly, once, in the words we actually use. %>
  <section id="area" class="section shell">
    <div class="section-heading">
      <div class="eyebrow">SERVICE AREA</div>
      <h2>Serving <%= serviceArea %>.</h2>
      <p class="lede smaller">
        If you are near enough that a truck and a crew can reach you in a morning, send the job in and we will tell
        you straight away whether we can take it.<% if (businessPhone) { %> Call or text
        <a class="text-link" href="tel:<%= telHref(businessPhone) %>"><%= businessPhone %></a> if you would rather ask
        first.<% } %>
      </p>
    </div>
  </section>

  <section class="section shell split">
    <div>
      <div class="eyebrow">REMOVE LESS &bull; RECOVER MORE</div>
      <h2>Not everything belongs in a dump.</h2>
      <p class="lede smaller">Usable items get separated for reuse, donation, recycling, scrap or resale when you authorize it. Less waste, and on some jobs a lower price for you.</p>
      <a class="button" href="/quote">Start a quote</a>
    </div>
    <div class="recovery-flow">
      <div>REMOVE</div><b>&rarr;</b><div>ASSESS</div><b>&rarr;</b><div>REUSE</div><b>&bull;</b><div>SCRAP</div><b>&bull;</b><div>SELL</div><b>&bull;</b><div>DISPOSE</div>
    </div>
  </section>
</main>

<%# Structured data. Built in server.js from values we actually hold -- no
    address, hours, prices, ratings or social profiles are invented. %>
<script type="application/ld+json"><%- jsonLd %></script>

<%- include('partials/foot') %>
