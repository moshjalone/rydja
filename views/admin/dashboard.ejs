<%- include('../partials/head', { title: 'Dashboard', noindex: true }) %>

<main id="main" tabindex="-1" class="shell dashboard">
  <div class="dash-head">
    <div>
      <div class="eyebrow">ADMIN</div>
      <h1>Dashboard</h1>
      <p class="dash-sub"><%= period.label %></p>
    </div>
    <div class="dash-actions">
      <a class="button small ghost" href="/admin/leads">Lead inbox</a>
      <a class="button small" href="/admin/jobs">Job board &rarr;</a>
    </div>
  </div>

  <h2 class="dash-h2">This month</h2>
  <div class="metrics five">
    <div><span>Leads</span><strong><%= month.leads %></strong></div>
    <div><span>Quotes sent</span><strong><%= month.quotesSent %></strong></div>
    <div><span>Quotes approved</span><strong><%= month.quotesApproved %></strong></div>
    <div><span>Jobs scheduled</span><strong><%= month.jobsScheduled %></strong></div>
    <div><span>Jobs completed</span><strong><%= month.jobsCompleted %></strong></div>
  </div>

  <%# Money is counted over the jobs completed inside the month, so revenue,
      expenses and salvage all describe the same set of work. %>
  <div class="metrics four money-row">
    <div><span>Customer revenue</span><strong><%= money(totals.revenue) %></strong></div>
    <div><span>Recorded expenses</span><strong><%= money(totals.expenses) %></strong></div>
    <div><span>Realized salvage</span><strong><%= money(totals.salvage) %></strong></div>
    <div class="net"><span>Net contribution</span><strong><%= money(totals.net) %></strong></div>
  </div>
  <p class="dash-note">
    Counted over jobs marked complete this month. Revenue less recorded expenses, plus salvage actually sold.
  </p>

  <%# The website's own side of the same month.

      Here rather than only on the traffic page because it answers the first
      question to ask when the lead count is low, and the answer changes what
      you do next: nobody arriving is a reach problem, and plenty arriving and
      nobody asking is a page problem. Four figures and a link; the detail
      lives on /admin/traffic. %>
  <h2 class="dash-h2">Website this month</h2>
  <div class="metrics four">
    <div><span>Visitors</span><strong><%= traffic.visitors %></strong></div>
    <div><span>Quote buttons clicked</span><strong><%= traffic.funnel.steps[1].people %></strong></div>
    <div><span>Forms started</span><strong><%= traffic.funnel.steps[3].people %></strong></div>
    <div><span>Call / text taps</span><strong><%= traffic.funnel.contact.call + traffic.funnel.contact.text %></strong></div>
  </div>
  <p class="dash-note">
    <% if (!traffic.visitors) { %>
      No measured visits yet this month. If that stays at zero the bottleneck is upstream of the site, not on it.
    <% } else if (!traffic.funnel.steps[4].people) { %>
      People are arriving and none of them has sent a request yet this month. That is a page problem, not a reach
      problem.
    <% } else { %>
      Visitors are counted per day and hold no identifier.
    <% } %>
    <% if (!traffic.crawled) { %>
      <strong>No search-engine crawler has fetched a page this month.</strong>
    <% } %>
    <a class="text-link" href="/admin/traffic">Full traffic and funnel &rarr;</a>
  </p>

  <%# What the acquisition work has actually produced.

      All-time rather than this month, deliberately: a referral relationship
      built in March pays in August, and a monthly window would keep resetting
      the one number that is meant to compound. Revenue counts completed jobs
      only — an approved quote is a promise. %>
  <h2 class="dash-h2">Acquisition, all time</h2>
  <div class="metrics four">
    <div><span>Partners</span><strong><%= acquisition.partners %></strong></div>
    <div><span>Open opportunities</span><strong><%= acquisition.openOpportunities %></strong></div>
    <div><span>Leads from partners</span><strong><%= acquisition.fromPartners.leads %></strong></div>
    <div class="net">
      <span>Revenue from both</span>
      <strong><%= money(acquisition.fromPartners.revenue + acquisition.fromOpportunities.revenue) %></strong>
    </div>
  </div>
  <p class="dash-note">
    <% if (!acquisition.partners && !acquisition.everRecorded) { %>
      Nothing on either list yet. The fastest start is the three or four businesses you already know by name
      &mdash; <a class="text-link" href="/admin/partners#add">add them as partners</a> &mdash; and this
      week&rsquo;s estate sales and county bid boards
      &mdash; <a class="text-link" href="/admin/opportunities#add">record what you find</a>.
    <% } else { %>
      <a class="text-link" href="/admin/partners">Partners</a> are relationships that pay repeatedly;
      <a class="text-link" href="/admin/opportunities">opportunities</a> are single advertised jobs with a deadline.
      Revenue is completed jobs traced back to one or the other.
    <% } %>
  </p>

  <h2 class="dash-h2">Needs attention</h2>
  <div class="attention">
    <% attention.forEach(function(item) { %>
      <a class="attention-item <%= item.n ? '' : 'quiet' %>" href="<%= item.href %>">
        <strong><%= item.n %></strong>
        <span><%= item.label %></span>
      </a>
    <% }) %>
  </div>

  <h2 class="dash-h2">Lead sources</h2>
  <% if (!sources.length) { %>
    <div class="panel empty">No leads yet this month.</div>
  <% } else { %>
    <div class="panel">
      <table class="rows">
        <thead>
          <tr><th>Source</th><th class="num">Leads</th><th class="num">Approved</th><th class="num">Rate</th></tr>
        </thead>
        <tbody>
          <% sources.forEach(function(row) { %>
            <tr>
              <td><span class="src-chip src-<%= row.source || 'unknown' %>"><%= row.label %></span></td>
              <td class="num" data-label="Leads"><%= row.leads %></td>
              <td class="num" data-label="Approved"><%= row.approved %></td>
              <%# A rate needs a denominator. No row reaches here with zero
                  leads, but the template still refuses to print "NaN%". %>
              <td class="num" data-label="Rate"><%= row.rate === null ? '—' : row.rate + '%' %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <p class="dash-note">
      Leads this month, and how many of them have an approved quote. A lead with no recorded source is shown as
      Unknown rather than counted as Direct.
    </p>
  <% } %>
</main>

<%- include('../partials/foot') %>
