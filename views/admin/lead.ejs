<%- include('../partials/head', { title: 'Lead #' + lead.id + ' · ' + lead.customer_name, noindex: true }) %>

<main class="shell dashboard">
  <div class="dash-head">
    <div>
      <div class="eyebrow"><a href="/admin/leads">&larr; Lead inbox</a></div>
      <div class="work-ref"><%= job ? 'Job' : 'Request' %> <%= lead.work_ref %></div>
      <h1><%= lead.customer_name %></h1>
      <p class="sub">
        <a class="text-link" href="tel:<%= telHref(lead.customer_phone) %>"><%= lead.customer_phone %></a>
        <% if (lead.customer_email) { %> &middot; <a class="text-link" href="mailto:<%= lead.customer_email %>"><%= lead.customer_email %></a><% } %>
      </p>
    </div>
    <span class="badge <%= lead.status %>"><%= prettyStatus(lead.status) %></span>
  </div>

  <div class="dash-grid">
    <div class="panel">
      <h2>The job</h2>
      <dl class="kv">
        <div><dt>Service</dt><dd><%= lead.service %></dd></div>
        <div><dt>Address</dt><dd>
          <% var addr = [lead.address, lead.city, lead.state, lead.zip].filter(Boolean).join(', ') %>
          <a class="text-link" target="_blank" rel="noopener" href="https://www.google.com/maps/search/?api=1&query=<%= encodeURIComponent(addr) %>"><%= addr %></a>
        </dd></div>
        <div><dt>Access</dt><dd><%= lead.access || '—' %></dd></div>
        <div><dt>Timing</dt><dd><%= lead.timing || '—' %></dd></div>
        <div><dt>Submitted</dt><dd><%= prettyDate(lead.created_at) %></dd></div>
        <div><dt>Customer link</dt><dd><a class="text-link" href="/q/<%= lead.public_token %>" target="_blank" rel="noopener">/q/<%= lead.public_token.slice(0, 8) %>… &nearr;</a></dd></div>
      </dl>
      <p class="desc-block"><%= lead.description %></p>

      <%# ---- what the customer asked for at intake ---- %>
      <% if (lead.pref_date_1 || lead.pref_date_2 || lead.scheduling_flexible || lead.scheduling_note) { %>
        <h3 class="sub-head">Customer availability</h3>
        <p class="price-note">Preferences from their request &mdash; not a booking.</p>
        <dl class="kv">
          <% if (lead.pref_date_1) { %>
            <div><dt>1st choice</dt><dd><%= prettyPrefDate(lead.pref_date_1) %><br><%= windowLabels[lead.pref_window_1] || lead.pref_window_1 %></dd></div>
          <% } %>
          <% if (lead.pref_date_2) { %>
            <div><dt>2nd choice</dt><dd><%= prettyPrefDate(lead.pref_date_2) %><br><%= windowLabels[lead.pref_window_2] || lead.pref_window_2 %></dd></div>
          <% } %>
          <div><dt>Flexible</dt><dd><%= lead.scheduling_flexible ? 'Yes' : 'No' %></dd></div>
          <% if (lead.scheduling_note) { %><div><dt>Note</dt><dd><%= lead.scheduling_note %></dd></div><% } %>
        </dl>
      <% } %>

      <% if (lead.customer_message) { %>
        <h3 class="sub-head">They asked a question</h3>
        <div class="customer-msg"><%= lead.customer_message %></div>
        <p class="price-note">Sent <%= prettyDate(lead.customer_message_at) %>. Call them back.</p>
      <% } %>

      <% if (history.length) { %>
        <h3 class="sub-head">Earlier requests from this customer</h3>
        <ul class="plain-list">
          <% history.forEach(function(h) { %>
            <li><a class="text-link" href="/admin/leads/<%= h.id %>"><%= h.service %></a> &middot; <%= prettyStatus(h.status) %> &middot; <%= prettyDate(h.created_at) %></li>
          <% }) %>
        </ul>
      <% } %>
    </div>

    <div class="panel">
      <div class="panel-head">
        <h2>Quote</h2>
        <% if (quote) { %><span class="badge <%= quote.status %>"><%= prettyStatus(quote.status) %></span><% } %>
      </div>

      <%# What became of the quote email, if one was just sent. %>
      <% if (mailState && mailState !== 'sent') { %>
        <div class="form-error">
          <% if (mailState === 'no_email') { %>
            Quote saved. No email address on file for this customer &mdash; text them the link.
          <% } else if (mailState === 'not_configured') { %>
            Quote saved, but email is switched off: set <code>RESEND_API_KEY</code> and <code>EMAIL_FROM</code>. Text them the link.
          <% } else { %>
            Quote saved, but the email could not be delivered (<%= mailState %>). Text them the link.
          <% } %>
        </div>
      <% } else if (mailState === 'sent') { %>
        <p class="price-note">Quote emailed to the customer.</p>
      <% } %>

      <% if (job) { %>
        <div class="big-price"><%= money(quote.amount_cents) %></div>
        <p class="price-note">Approved <%= prettyDate(quote.responded_at) %>. This is now a job.</p>
        <a class="button full" href="/admin/jobs/<%= job.id %>">Open job #<%= job.id %> &rarr;</a>
      <% } else { %>
        <% if (quote && quote.status === 'sent') { %>
          <div class="big-price"><%= money(quote.amount_cents) %></div>
          <p class="price-note">Sent <%= prettyDate(quote.created_at) %> &mdash; waiting on the customer. Send a new amount below to replace it.</p>
        <% } else if (quote && quote.status === 'declined') { %>
          <p class="price-note"><%= money(quote.amount_cents) %> declined <%= prettyDate(quote.responded_at) %>. You can send a revised quote.</p>
        <% } %>

        <form method="post" action="/admin/leads/<%= lead.id %>/quote" class="stack-form">
          <label>Price to the customer
            <input name="amount" inputmode="decimal" placeholder="450" required autocomplete="off">
          </label>
          <label>Notes shown to the customer <span class="hint">optional</span>
            <textarea name="notes" rows="4" placeholder="Includes labor, hauling and dump fees. Price assumes driveway access and nothing from the attic."><%= quote && quote.status !== 'approved' ? (quote.notes || '') : '' %></textarea>
          </label>

          <%# Optional. With a time attached the customer can agree to both at
              once; without one the quote behaves exactly as it always has. %>
          <label>Propose an appointment <span class="hint">optional &mdash; they confirm it with the quote</span>
            <input type="datetime-local" name="proposed_for" value="<%= quote && quote.status === 'sent' && quote.proposed_for ? quote.proposed_for.replace(' ', 'T').slice(0, 16) : '' %>">
          </label>
          <% if (lead.pref_date_1 || lead.pref_date_2) { %>
            <small class="fineprint">
              They asked for
              <% if (lead.pref_date_1) { %><strong><%= prettyPrefDate(lead.pref_date_1) %>, <%= (windowLabels[lead.pref_window_1] || '').toLowerCase() %></strong><% } %>
              <% if (lead.pref_date_2) { %> or <strong><%= prettyPrefDate(lead.pref_date_2) %>, <%= (windowLabels[lead.pref_window_2] || '').toLowerCase() %></strong><% } %>.
              Use one of those or pick your own.
            </small>
          <% } %>
          <button class="button full" type="submit"><%= quote ? 'Send revised quote' : 'Send quote' %></button>
          <small class="fineprint">Then text the customer their link: <code>/q/<%= lead.public_token %></code></small>
        </form>

        <form method="post" action="/admin/leads/<%= lead.id %>/status" class="inline-form right">
          <input type="hidden" name="status" value="declined">
          <button class="linkish danger" type="submit">Mark lead dead</button>
        </form>
      <% } %>
    </div>
  </div>

  <div class="panel">
    <h2>Customer photos (<%= photos.length %>)</h2>
    <% if (!photos.length) { %>
      <p class="muted">None sent. Call and ask for a few.</p>
    <% } else { %>
      <div class="photo-grid">
        <% photos.forEach(function(p) { %>
          <a href="/uploads/<%= p.filename %>" target="_blank" rel="noopener"><img src="/uploads/<%= p.filename %>" alt="Lead photo" loading="lazy"></a>
        <% }) %>
      </div>
    <% } %>
  </div>
</main>

<%- include('../partials/foot') %>
