<%- include('../partials/head', { title: 'Lead inbox', noindex: true }) %>

<main class="shell dashboard">
  <div class="dash-head">
    <div>
      <div class="eyebrow">ADMIN</div>
      <h1>Lead inbox</h1>
    </div>
    <a class="button small" href="/admin/jobs">Job board &rarr;</a>
  </div>

  <div class="metrics three">
    <div><span>New</span><strong><%= counts.new %></strong></div>
    <div><span>Awaiting answer</span><strong><%= counts.quoted %></strong></div>
    <div><span>Open jobs</span><strong><%= counts.openJobs %></strong></div>
  </div>

  <% if (!leads.length) { %>
    <div class="panel empty">No leads yet. Share the quote form: <code>/quote</code></div>
  <% } else { %>
    <div class="jobs">
      <div class="job-row header-row lead-row">
        <div>Customer</div><div>Service</div><div>Where</div><div>Photos</div><div>Quote</div><div>Status</div><div></div>
      </div>
      <% leads.forEach(function(l) { %>
        <div class="job-row lead-row">
          <div>
            <strong><%= l.customer_name %></strong>
            <small><a href="tel:<%= telHref(l.customer_phone) %>"><%= l.customer_phone %></a></small>
          </div>
          <div><%= l.service %><small><%= prettyDate(l.created_at) %></small></div>
          <div data-label="Where"><%= [l.city, l.zip].filter(Boolean).join(" ") %></div>
          <div data-label="Photos"><%= l.photo_count %></div>
          <div data-label="Quote"><%= l.quote_cents ? money(l.quote_cents) : '—' %></div>
          <div><span class="badge <%= l.status %>"><%= prettyStatus(l.status) %></span></div>
          <div><a class="button small" href="/admin/leads/<%= l.id %>">Open</a></div>
        </div>
      <% }) %>
    </div>
  <% } %>
</main>

<%- include('../partials/foot') %>
