<%- include('../partials/head', { title: 'Edit lead', noindex: true }) %>
<%
  // On a validation failure the form comes back filled with what was typed,
  // not with what is in the database -- retyping a long description because
  // of a bad ZIP would be its own small insult.
  var v = values || lead;
  var val = function (key) { return v[key] == null ? '' : String(v[key]); };
%>

<main id="main" tabindex="-1" class="shell dashboard narrow">
  <div class="dash-head">
    <div>
      <div class="eyebrow">ADMIN &middot; <%= lead.work_ref %></div>
      <h1>Edit lead</h1>
    </div>
    <a class="button small ghost" href="/admin/leads/<%= lead.id %>">Cancel</a>
  </div>

  <% if (error) { %><div class="panel error"><%= error %></div><% } %>

  <form method="post" action="/admin/leads/<%= lead.id %>/edit" class="panel form-grid">
    <h2>Customer</h2>
    <label>Name<input name="name" value="<%= val('customer_name') %>" maxlength="120" required></label>
    <label>Phone<input name="phone" value="<%= val('customer_phone') %>" maxlength="30" required></label>
    <label>Email<input name="email" type="email" value="<%= val('customer_email') %>" maxlength="160"></label>
    <p class="field-note">
      The phone number identifies the customer. Changing it renames them everywhere, on this lead and on every
      other one they have.
    </p>

    <h2>The job</h2>
    <label>Service
      <select name="service">
        <% quoteServices.forEach(function(s) { %>
          <option value="<%= s %>" <%= val('service') === s ? 'selected' : '' %>><%= s %></option>
        <% }) %>
        <%# A lead taken under an older label keeps it unless it is changed. %>
        <% if (val('service') && quoteServices.indexOf(val('service')) === -1) { %>
          <option value="<%= val('service') %>" selected><%= val('service') %> (current)</option>
        <% } %>
      </select>
    </label>
    <label>Address<input name="address" value="<%= val('address') %>" maxlength="160"></label>
    <div class="form-row three">
      <label>City<input name="city" value="<%= val('city') %>" maxlength="60"></label>
      <label>State<input name="state" value="<%= val('state') %>" maxlength="30"></label>
      <label>ZIP<input name="zip" value="<%= val('zip') %>" maxlength="12" required></label>
    </div>
    <div class="form-row two">
      <label>Access<input name="access" value="<%= val('access') %>" maxlength="60"></label>
      <label>Timing<input name="timing" value="<%= val('timing') %>" maxlength="40"></label>
    </div>
    <label>Description<textarea name="description" rows="5" maxlength="4000" required><%= val('description') %></textarea></label>

    <h2>Status</h2>
    <label>Lead status
      <select name="status">
        <% ['new', 'quoted', 'declined', 'converted'].forEach(function(s) { %>
          <option value="<%= s %>" <%= val('status') === s ? 'selected' : '' %>><%= prettyStatus(s) %></option>
        <% }) %>
      </select>
    </label>

    <% if (quote) { %>
      <h2>Money</h2>
      <label>Quote amount
        <input name="amount" inputmode="decimal" value="<%= val('amount') || (quote.amount_cents / 100).toFixed(2) %>">
      </label>
      <% if (quote.status === 'approved') { %>
        <p class="field-note warn">
          <strong>This quote was approved by the customer</strong><% if (quote.responded_at) { %> on <%= prettyDate(quote.responded_at) %><% } %><% if (quote.terms_version) { %>,
          under Terms <%= quote.terms_version %><% } %>. They agreed to <%= money(quote.amount_cents) %>.
          Changing the figure rewrites the price on a job they have already said yes to. The acceptance record
          itself is kept, and the old amount is noted against the quote.
        </p>
      <% } else if (quote.status === 'sent') { %>
        <p class="field-note">
          This quote is still unanswered. Editing the amount here changes it quietly &mdash; it does not send the
          customer a new one. To tell them, send a revised quote from the lead page instead.
        </p>
      <% } else { %>
        <p class="field-note">This quote was declined. The amount is editable for the record.</p>
      <% } %>
    <% } %>

    <div class="form-actions">
      <button class="button" type="submit">Save changes</button>
      <a class="text-link" href="/admin/leads/<%= lead.id %>">Cancel</a>
    </div>
  </form>

  <div class="panel subtle">
    <p>
      Nothing here deletes anything. To take this lead out of the inbox and out of every total, archive it from
      the <a class="text-link" href="/admin/leads">lead inbox</a> &mdash; it can be restored at any time.
    </p>
  </div>
</main>

<%- include('../partials/foot') %>
