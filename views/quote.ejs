<%- include('partials/head', {
  title: 'Request a Quote',
  canonicalPath: '/quote',
  description: 'Send photos of the job and get a price back. No obligation.'
}) %>
<% var v = function(k, fallback) { return values && values[k] != null && values[k] !== '' ? values[k] : (fallback || ''); } %>

<main id="main" tabindex="-1" class="section dark">
  <div class="shell form-shell">
    <div class="form-intro">
      <div class="eyebrow">REQUEST A QUOTE</div>
      <h1>Send the job.</h1>
      <p>Give us enough to understand the work. Photos are the fastest way to an accurate price &mdash; shoot everything you want gone, plus the path out to the driveway.</p>
      <% if (businessPhone) { %><p>Rather talk? Call <a class="text-link accent" href="tel:<%= telHref(businessPhone) %>"><%= businessPhone %></a> or <a class="text-link accent" href="sms:<%= smsHref(businessPhone) %>">text us</a></p><% } %>
    </div>

    <form class="quote-form" method="post" action="/quote" enctype="multipart/form-data">
      <% if (error) { %><div class="form-error"><%= error %></div><% } %>

      <%# Bot filter: a signed timestamp proving this form came from our server
          and was issued recently. It is the only hidden field — a decoy input
          used to be here too, and browsers autofilled it for real customers. %>
      <input type="hidden" name="form_stamp" value="<%= stamp %>">

      <div class="two">
        <label>Name<input required name="name" value="<%= v('name') %>" placeholder="Your name"></label>
        <label>Phone<input required name="phone" type="tel" value="<%= v('phone') %>" placeholder="(555) 555-5555"></label>
      </div>
      <div class="two">
        <label>ZIP code<input required name="zip" inputmode="numeric" value="<%= v('zip') %>" placeholder="49503"></label>
        <label>Email <span class="hint">optional</span><input name="email" type="email" value="<%= v('email') %>" placeholder="you@example.com"></label>
      </div>

      <label>What do you need?
        <select required name="service">
          <option value="">Choose a service</option>
          <%# The list lives in server.js, so the server can recognise what
              the customer picked rather than matching on a string the
              template owns. %>
          <% var options = quoteServices;
             var preset = v('service', service); %>
          <% options.forEach(function(o) { %>
            <option<%= preset === o ? ' selected' : '' %>><%= o %></option>
          <% }) %>
          <% if (preset && options.indexOf(preset) === -1) { %><option selected><%= preset %></option><% } %>
        </select>
      </label>

      <label>Describe the job
        <textarea required name="description" rows="5" placeholder="Example: One-car garage, mostly boxes and old furniture. Everything can go except the red toolbox."><%= v('description') %></textarea>
      </label>

      <%# The photo upload sits here, directly under the description, because
          this is the one field that most decides whether we can price the job
          at all. It used to be the last thing before the button, below three
          optional sections -- which is a long way to scroll past things you do
          not have to fill in to reach the thing we most want. %>
      <label class="upload">
        <span>Photos</span>
        <input type="file" name="photos" accept="image/*" multiple>
        <small>Up to 12 photos. Clear shots of everything you want handled, plus the way out to the driveway.</small>
      </label>

      <div class="two">
        <label>Where is the material?
          <select name="access">
            <% ['Ground level / easy access','Inside house','Basement','Upstairs','Garage / barn','Yard / outdoors','Storage facility'].forEach(function(o) { %>
              <option<%= v('access') === o ? ' selected' : '' %>><%= o %></option>
            <% }) %>
          </select>
        </label>
        <label>Timing
          <select name="timing">
            <% ['ASAP','Within 2-3 days','This week','Flexible'].forEach(function(o) { %>
              <option<%= v('timing') === o ? ' selected' : '' %>><%= o %></option>
            <% }) %>
          </select>
        </label>
      </div>

      <%# ---- optional: where the property is ----
          Three fields that help us judge access and route, and not one of them
          is needed to get a price -- the ZIP above is. Collapsed, so the path
          to the button is short for somebody who just wants a number, and open
          already if a rejected submission came back carrying any of it.

          <details> rather than a script: the inputs are in the DOM whether the
          section was ever opened or not, so everything typed into it is
          submitted, and the form behaves identically with JavaScript blocked. %>
      <% var addressOpen = Boolean(v('address') || v('city') || v('state')) %>
      <details class="prefs" <%= addressOpen ? 'open' : '' %>>
        <summary>Where is the property? <span class="optional-tag">optional</span></summary>
        <div class="details-body">
          <p class="hint block">
            Helps us judge access and plan the route. Your ZIP above is enough for a price.
          </p>
          <label>Street address
            <input name="address" value="<%= v('address') %>" placeholder="123 Main St">
          </label>
          <div class="two">
            <label>City<input name="city" value="<%= v('city') %>"></label>
            <label>State<input name="state" value="<%= v('state') %>" maxlength="20"></label>
          </div>
        </div>
      </details>

      <%# ---- optional: estate / whole-property detail ----
          Revealed for the flagship service only. Nothing here is required:
          the point is to save a phone call, not to make somebody inventory a
          house they have just inherited. %>
      <% var estateOpen = isEstateService(preset) %>
      <fieldset class="prefs estate-fields" data-estate-fields data-estate-service="<%= estateService %>"<%= estateOpen ? '' : ' hidden' %>>
        <legend>About the property</legend>
        <p class="hint block">
          Optional, and useful rather than required &mdash; it helps us price the job from your photos.
          Don&rsquo;t worry about listing individual items.
        </p>

        <fieldset class="checks">
          <legend>Which areas need clearing?</legend>
          <% estateAreas.forEach(function(area) { %>
            <label class="check">
              <input type="checkbox" name="estate_areas" value="<%= area %>"<%= (values && [].concat(values.estate_areas || []).indexOf(area) !== -1) ? ' checked' : '' %>>
              <%= area %>
            </label>
          <% }) %>
        </fieldset>

        <label>Roughly how much of it?
          <select name="estate_scope">
            <option value="">Choose one &mdash; optional</option>
            <% estateScopes.forEach(function(scope) { %>
              <option<%= v('estate_scope') === scope ? ' selected' : '' %>><%= scope %></option>
            <% }) %>
          </select>
        </label>

        <label>Is there a deadline, closing date or move-out date? <span class="hint">optional</span>
          <input name="estate_deadline" maxlength="200" value="<%= v('estate_deadline') %>" placeholder="Example: has to be empty before the closing on the 14th">
        </label>
      </fieldset>

      <%# ---- optional: when would suit them ----
          Collapsed by default, and the reason is the whole point of this pass:
          nobody should have to plan an appointment in order to ask what a job
          costs. These were four visible scheduling controls between the
          customer and the submit button, every one of them optional.

          Open already if a submission came back carrying any preference, so a
          validation error never appears to have swallowed what somebody typed.
          The inputs are in the DOM either way, so a closed section still posts
          whatever is in it. %>
      <%
        const schedulingOpen = Boolean(
          v('preferred_date_1') || v('preferred_date_2') || v('scheduling_note') ||
          (values && values.scheduling_flexible)
        );
      %>
      <details class="prefs" <%= schedulingOpen ? 'open' : '' %>>
        <summary>When would you like us to come? <span class="optional-tag">optional</span></summary>
        <div class="details-body">
        <p class="hint block">
          These are preferred times, not confirmed appointments. We&rsquo;ll confirm availability with your quote.
          Leave it blank if you&rsquo;d rather talk it through.
        </p>

        <div class="two">
          <label>1st choice <span class="hint">optional</span>
            <input type="date" name="preferred_date_1" min="<%= today %>" value="<%= v('preferred_date_1') %>">
          </label>
          <label>Time of day
            <select name="preferred_window_1">
              <% timeWindows.forEach(function(w) { %>
                <option value="<%= w.value %>"<%= (v('preferred_window_1') || 'flexible') === w.value ? ' selected' : '' %>><%= w.label %> &middot; <%= w.hint %></option>
              <% }) %>
            </select>
          </label>
        </div>

        <div class="two">
          <label>2nd choice <span class="hint">optional</span>
            <input type="date" name="preferred_date_2" min="<%= today %>" value="<%= v('preferred_date_2') %>">
          </label>
          <label>Time of day
            <select name="preferred_window_2">
              <% timeWindows.forEach(function(w) { %>
                <option value="<%= w.value %>"<%= (v('preferred_window_2') || 'flexible') === w.value ? ' selected' : '' %>><%= w.label %> &middot; <%= w.hint %></option>
              <% }) %>
            </select>
          </label>
        </div>

        <label class="check">
          <input type="checkbox" name="scheduling_flexible" value="1"<%= values && values.scheduling_flexible ? ' checked' : '' %>>
          I&rsquo;m flexible &mdash; work around what suits you.
        </label>

        <label>Anything we should know about timing? <span class="hint">optional</span>
          <textarea name="scheduling_note" rows="2" maxlength="300" placeholder="Example: After 3 PM is easiest. Gate code is on the sign."><%= v('scheduling_note') %></textarea>
        </label>
        </div>
      </details>

      <label class="check">
        <input type="checkbox" name="hazard_ack" value="1" required>
        I confirm this job does not knowingly include hazardous waste, asbestos, biohazards, unknown chemicals or other regulated materials.
      </label>

      <button class="button full" type="submit">Send Quote Request</button>
      <small class="fineprint">We review the job and send a price to your phone. No obligation.</small>
    </form>
  </div>
</main>

<%- include('partials/foot') %>
